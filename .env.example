# Copy to ignored .env and replace placeholders locally before starting PostgreSQL.
# Compose reads .env; use `uv run --env-file .env dataguard-ai ingest` for Python.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dataguard_ai
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me

# Optional Phase 4B provider; key alone does not enable paid requests.
# Real calls require prior approval and --allow-paid-api.
OPENAI_API_KEY=replace_me
